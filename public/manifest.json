{
  "manifest_version": 3,
  "name": "PLaMo Translate",
  "version": "0.0.1",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["selection.js"] }],
  "web_accessible_resources": [{ "resources": ["translation-button.jpg"], "matches": ["<all_urls>"] }],
  "permissions":["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["http://localhost:11434/*"]
}
